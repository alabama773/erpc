{
  "info": {
    "name": "Solana Failover Gateway",
    "description": "Test collection for the Solana failover RPC gateway (custom Node/TS layer).\n\nGateway runs on http://localhost:4100\n\nStart it first:\n  cd solana && npm run serve\n\nEvery response includes an **X-RPC-Provider** response header showing which provider served the call (helius/publicnode/drpc/ankr/solana-public) - check the Headers tab to watch failover happen. Send the same request rapidly to see it fail over from helius to a backup under load.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "solana", "value": "http://localhost:4100", "type": "string" },
    { "key": "usdc_mint", "value": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", "type": "string" },
    { "key": "wallet", "value": "G9L3ac8qYKNy1gTxdmhxTbDVyGHf5NAaSDYzvkgitVLJ", "type": "string" },
    { "key": "wallet2", "value": "5eHhjP8JaYkz83CWwvGU2uMUXefd3AazWGx4gpcuEEYD", "type": "string" },
    { "key": "slot", "value": "435464598", "type": "string" }
  ],
  "item": [
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{solana}}/health", "host": ["{{solana}}"], "path": ["health"] }
      }
    },
    {
      "name": "GET /stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{solana}}/stats", "host": ["{{solana}}"], "path": ["stats"] }
      }
    },
    {
      "name": "getHealth",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getHealth\",\n  \"params\": []\n}" }
      }
    },
    {
      "name": "getSlot",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSlot\",\n  \"params\": []\n}" }
      }
    },
    {
      "name": "getBalance (wallet)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getBalance\",\n  \"params\": [\"{{wallet}}\"]\n}" }
      }
    },
    {
      "name": "getTokenAccountsByOwner (USDC)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getTokenAccountsByOwner\",\n  \"params\": [\n    \"{{wallet}}\",\n    { \"mint\": \"{{usdc_mint}}\" },\n    { \"encoding\": \"jsonParsed\" }\n  ]\n}" }
      }
    },
    {
      "name": "getSignaturesForAddress",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSignaturesForAddress\",\n  \"params\": [\n    \"{{wallet}}\",\n    { \"limit\": 10 }\n  ]\n}" }
      }
    },
    {
      "name": "getBlock (by slot, signatures only)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getBlock\",\n  \"params\": [\n    {{slot}},\n    {\n      \"encoding\": \"jsonParsed\",\n      \"maxSupportedTransactionVersion\": 0,\n      \"transactionDetails\": \"signatures\",\n      \"rewards\": false\n    }\n  ]\n}" }
      }
    },
    {
      "name": "Batch (getHealth + getSlot)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
        "body": { "mode": "raw", "raw": "[\n  { \"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"getHealth\", \"params\": [] },\n  { \"jsonrpc\": \"2.0\", \"id\": 2, \"method\": \"getSlot\", \"params\": [] }\n]" }
      }
    }
  ]
}
