{
  "info": {
    "name": "eRPC Gateway + Solana Failover",
    "description": "Two RPC paths:\n\n1. eRPC (EVM: Ethereum + BSC) on http://localhost:4000  - fault-tolerant EVM proxy with built-in failover/retry/cache.\n2. Solana failover gateway on http://localhost:4100  - custom Node/TS layer (eRPC does NOT support Solana).\n\nStart both first:\n  eRPC:   cd gateway && docker compose up -d\n  Solana: cd solana && docker compose up -d\n\nEVM URL pattern: /main/evm/<chainId>  (1 = Ethereum, 56 = BSC)\nSolana responses carry an X-RPC-Provider header showing which provider served the call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "erpc", "value": "http://localhost:4000", "type": "string" },
    { "key": "solana", "value": "http://localhost:4100", "type": "string" },
    { "key": "eth_chain", "value": "1", "type": "string" },
    { "key": "bsc_chain", "value": "56", "type": "string" },
    { "key": "usdc_mint", "value": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", "type": "string" },
    { "key": "wallet", "value": "G9L3ac8qYKNy1gTxdmhxTbDVyGHf5NAaSDYzvkgitVLJ", "type": "string" },
    { "key": "slot", "value": "435464598", "type": "string" }
  ],
  "item": [
    {
      "name": "eRPC - Ethereum (chainId 1)",
      "item": [
        {
          "name": "eth_blockNumber",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{erpc}}/main/evm/{{eth_chain}}", "host": ["{{erpc}}"], "path": ["main", "evm", "{{eth_chain}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_blockNumber\",\n  \"params\": [],\n  \"id\": 1\n}" }
          }
        },
        {
          "name": "eth_chainId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{erpc}}/main/evm/{{eth_chain}}", "host": ["{{erpc}}"], "path": ["main", "evm", "{{eth_chain}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_chainId\",\n  \"params\": [],\n  \"id\": 1\n}" }
          }
        },
        {
          "name": "eth_getBalance (vitalik.eth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{erpc}}/main/evm/{{eth_chain}}", "host": ["{{erpc}}"], "path": ["main", "evm", "{{eth_chain}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_getBalance\",\n  \"params\": [\"0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045\", \"latest\"],\n  \"id\": 1\n}" }
          }
        }
      ]
    },
    {
      "name": "eRPC - BSC (chainId 56)",
      "item": [
        {
          "name": "eth_blockNumber",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{erpc}}/main/evm/{{bsc_chain}}", "host": ["{{erpc}}"], "path": ["main", "evm", "{{bsc_chain}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_blockNumber\",\n  \"params\": [],\n  \"id\": 1\n}" }
          }
        },
        {
          "name": "eth_chainId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{erpc}}/main/evm/{{bsc_chain}}", "host": ["{{erpc}}"], "path": ["main", "evm", "{{bsc_chain}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_chainId\",\n  \"params\": [],\n  \"id\": 1\n}" }
          }
        }
      ]
    },
    {
      "name": "Solana Gateway (failover)",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{solana}}/health", "host": ["{{solana}}"], "path": ["health"] }
          }
        },
        {
          "name": "GET /stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{solana}}/stats", "host": ["{{solana}}"], "path": ["stats"] }
          }
        },
        {
          "name": "getSlot",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSlot\",\n  \"params\": []\n}" }
          }
        },
        {
          "name": "getBalance (wallet)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getBalance\",\n  \"params\": [\"{{wallet}}\"]\n}" }
          }
        },
        {
          "name": "getTokenAccountsByOwner (USDC)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{solana}}/", "host": ["{{solana}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getTokenAccountsByOwner\",\n  \"params\": [\n    \"{{wallet}}\",\n    { \"mint\": \"{{usdc_mint}}\" },\n    { \"encoding\": \"jsonParsed\" }\n  ]\n}" }
          }
        },
        {
          "name": "USDC transfers in a block (from -> to)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{solana}}/block/{{slot}}", "host": ["{{solana}}"], "path": ["block", "{{slot}}"] }
          }
        },
        {
          "name": "USDC transfers for an address (from -> to)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{solana}}/address/{{wallet}}?limit=30", "host": ["{{solana}}"], "path": ["address", "{{wallet}}"], "query": [{ "key": "limit", "value": "30" }] }
          }
        }
      ]
    }
  ]
}
