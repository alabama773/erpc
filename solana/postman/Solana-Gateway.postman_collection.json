{
  "info": {
    "name": "Solana Gateway (sol-erpc)",
    "description": "Solana failover RPC gateway + USDC transfer indexer.\n\nBase URL: http://localhost:4100\nStart it: cd solana && docker compose up -d\n\nEvery response carries an X-RPC-Provider header showing which provider served the call (helius/publicnode/drpc/ankr/solana-public). Fire requests rapidly to watch failover from helius to a backup under load.\n\nKey endpoints for USDC transfers (from/to/block/price/unit):\n  GET /block/<slot>      all USDC transfers in a block\n  GET /address/<wallet>  recent USDC transfers touching a wallet",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:4100", "type": "string" },
    { "key": "wallet", "value": "G9L3ac8qYKNy1gTxdmhxTbDVyGHf5NAaSDYzvkgitVLJ", "type": "string" },
    { "key": "wallet2", "value": "5eHhjP8JaYkz83CWwvGU2uMUXefd3AazWGx4gpcuEEYD", "type": "string" },
    { "key": "usdc_mint", "value": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v", "type": "string" },
    { "key": "slot", "value": "435464598", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Basics",
      "item": [
        {
          "name": "GET /health (service + 5 providers)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/health", "host": ["{{base}}"], "path": ["health"] },
            "description": "Confirms the gateway is up and lists the 5 providers."
          }
        },
        {
          "name": "GET /stats (per-provider counters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/stats", "host": ["{{base}}"], "path": ["stats"] },
            "description": "Per-provider request/success/rate-limit counts. API keys are redacted (host only). Normally only helius shows traffic; backups get traffic only when helius is rate-limited."
          }
        }
      ]
    },
    {
      "name": "2. Basic RPC (POST /, with failover)",
      "item": [
        {
          "name": "getSlot (proves live chain)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSlot\",\n  \"params\": []\n}" },
            "description": "Current slot. Send twice - the number grows (~1 per 0.4s), proving a live mainnet connection. Check the X-RPC-Provider response header."
          }
        },
        {
          "name": "getBalance (SOL balance)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getBalance\",\n  \"params\": [\"{{wallet}}\"]\n}" }
          }
        },
        {
          "name": "getTokenAccountsByOwner (USDC account)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getTokenAccountsByOwner\",\n  \"params\": [\n    \"{{wallet}}\",\n    { \"mint\": \"{{usdc_mint}}\" },\n    { \"encoding\": \"jsonParsed\" }\n  ]\n}" }
          }
        },
        {
          "name": "getSignaturesForAddress (recent txns)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSignaturesForAddress\",\n  \"params\": [\n    \"{{wallet}}\",\n    { \"limit\": 10 }\n  ]\n}" }
          }
        },
        {
          "name": "getTransaction (single tx detail)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getTransaction\",\n  \"params\": [\n    \"PUT_A_SIGNATURE_HERE\",\n    { \"encoding\": \"jsonParsed\", \"maxSupportedTransactionVersion\": 0 }\n  ]\n}" },
            "description": "Replace PUT_A_SIGNATURE_HERE with a signature from getSignaturesForAddress."
          }
        }
      ]
    },
    {
      "name": "3. USDC transfers (from/to/block/price/unit)",
      "item": [
        {
          "name": "GET /block/<slot> - all USDC transfers in a block",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/block/{{slot}}", "host": ["{{base}}"], "path": ["block", "{{slot}}"] },
            "description": "Every USDC transfer in the block. Each item has: from, to, amount, unit (USDC), price (live USD), valueUsd, block, signature."
          }
        },
        {
          "name": "GET /block/<slot>?address= - filter one address",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/block/{{slot}}?address=6LY1JzAFVZsP2a2xKrtU6znQMQ5h4i7tocWdgrkZzkzF", "host": ["{{base}}"], "path": ["block", "{{slot}}"], "query": [{ "key": "address", "value": "6LY1JzAFVZsP2a2xKrtU6znQMQ5h4i7tocWdgrkZzkzF" }] }
          }
        },
        {
          "name": "GET /address/<wallet> - wallet USDC transfers",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base}}/address/{{wallet}}?limit=30", "host": ["{{base}}"], "path": ["address", "{{wallet}}"], "query": [{ "key": "limit", "value": "30" }] },
            "description": "Recent USDC transfers touching the wallet. Each item has: direction (in/out), from, to, amount, unit (USDC), price, valueUsd, block, signature. limit = signatures scanned (default 25, max 200)."
          }
        }
      ]
    },
    {
      "name": "4. Failover demo (watch backups take over)",
      "item": [
        {
          "name": "getSlot x1 (Send this many times fast)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base}}/", "host": ["{{base}}"], "path": [""] },
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"getSlot\",\n  \"params\": []\n}" },
            "description": "Demo: 1) GET /stats (only helius has traffic). 2) Hit this rapidly using Postman Runner with many iterations. 3) GET /stats again - publicnode now shows traffic, proving failover when helius gets rate-limited."
          }
        }
      ]
    }
  ]
}
