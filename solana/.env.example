# ---- Cluster ----
# Which Solana cluster to talk to: mainnet (default) or devnet.
# devnet is handy for inspecting a Phantom devnet transaction. It uses the
# devnet provider keys below and defaults USDC_MINT to the devnet USDC mint.
#SOLANA_CLUSTER=mainnet

# ---- Solana RPC providers (ordered: primary first, then fallbacks) ----
# Helius: put your full URL with API key here. This is the primary provider.
# Get it from https://dashboard.helius.dev/
HELIUS_RPC_URL=

# Free public fallbacks (no key needed). Leave as-is or override.
PUBLICNODE_RPC_URL=https://solana-rpc.publicnode.com

# Official public endpoint. Heavily rate-limited on purpose - great as the
# "victim" provider for the rate-limit test. Used as a last-resort fallback.
SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Optional extra fallbacks. As of 2026-08 these free public endpoints stopped
# working (drpc -> HTTP 400, ankr -> HTTP 403 without a key), so they are left
# commented out. Uncomment and supply a working URL (with API key if needed).
#DRPC_RPC_URL=https://solana.drpc.org
#ANKR_RPC_URL=https://rpc.ankr.com/solana

# ---- Devnet providers (only used when SOLANA_CLUSTER=devnet) ----
# Helius devnet URL with API key (optional). If empty, the gateway falls back to
# the official public devnet endpoint automatically, so devnet works with no key.
#HELIUS_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
#SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# ---- Indexer settings ----
# SPL mint the indexer tracks. Leave unset to use the cluster's native USDC mint:
#   mainnet -> EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   devnet  -> 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Set it explicitly only to index a different token (e.g. a devnet test token).
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Comma-separated wallet addresses to index for `npm run index:addresses`
WALLET_ADDRESSES=5eHhjP8JaYkz83CWwvGU2uMUXefd3AazWGx4gpcuEEYD,G9L3ac8qYKNy1gTxdmhxTbDVyGHf5NAaSDYzvkgitVLJ
